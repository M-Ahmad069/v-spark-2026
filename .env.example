# Firebase web app config (public by design — security comes from Firebase Auth rules + server checks)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Supabase (server only — never expose the secret key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Google Gemini (server only)
GEMINI_API_KEY=
# optional, defaults to gemini-2.5-flash
GEMINI_MODEL=

# Gmail SMTP for notification emails (server only; use a Google "app password")
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Shared secret that Supabase pg_cron sends to /api/cron
CRON_SECRET=
